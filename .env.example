# Copy to .env (or export in your shell). All optional — defaults shown.

# Shown in the top brand bar and page titles
AGENCY_NAME=Routebook Desk

# Public base URL of this CRM (Grok Bot / integrations use this)
CRM_BASE_URL=http://127.0.0.1:8787

# Default currency for new leads, packages, and money formatting.
# Full ISO 4217 display codes are supported; no FX conversion. Default: USD.
DEFAULT_CURRENCY=USD
